# yosys-cell-exclusion.ys -- the exact mapping script rows 2, 5 and 6 of
# issue #132's lever matrix were produced with. Frozen as evidence; see
# candidates/README.md.
#
# COMMIT-SAFE FORM. Machine-specific absolute paths have been substituted
# back to $PDK_ROOT (which Yosys does NOT expand) and to repo-relative
# paths -- same convention `klt synthesize` uses for the .ys it commits.
# Substitute your own PDK install root before running.
#
# This is `klt synthesize`'s own generated script for this design, with one
# addition: 209 extra `-dont_use <cell>` flags on the `abc` call. Those 209
# are exactly the cells with
#   worst_arc_any_polarity_floor_ns_ss_n40C_1v28 > 1.0
# in candidates/cell-delay-floors.json -- i.e. every cell with at least one
# input pin that, on at least one transition direction, cannot switch in
# under 1.0 ns at the binding corner (>10% of the 10.0 ns period, for one
# gate, before any load). The list is re-derivable from that JSON alone and
# was cross-checked name-for-name against this script.
#
# WHY THIS IS NOT A COMMITTED RECIPE: `klt synthesize` has no request-level
# cell-exclusion field (klayout-tools#2382), so this step had to bypass
# `klt` and call Yosys directly. That is precisely why rows 2/5/6 -- and
# the 18/18 timing closure row 6 demonstrates -- are NOT landed. See
# spec/decision-records/0004-... Decision 1.
#
# The `modexp_serial.v` source below is candidates/rtl/modexp-bit-serial.v
# (rows 5 and 6); row 2 is the same script against the committed
# rtl/modexp.v instead.

read_verilog flow/build/exp-serial/modexp_serial.v
hierarchy -check -top modexp
synth -top modexp
dfflibmap -liberty $PDK_ROOT/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ss_n40C_1v28.lib
abc -liberty $PDK_ROOT/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ss_n40C_1v28.lib -constr flow/build/exp-dontuse/abc.constr -D 10000 -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe* -dont_use sky130_fd_sc_hd__a2111o_1 -dont_use sky130_fd_sc_hd__a2111o_2 -dont_use sky130_fd_sc_hd__a2111o_4 -dont_use sky130_fd_sc_hd__a2111oi_0 -dont_use sky130_fd_sc_hd__a2111oi_1 -dont_use sky130_fd_sc_hd__a2111oi_2 -dont_use sky130_fd_sc_hd__a2111oi_4 -dont_use sky130_fd_sc_hd__a211o_1 -dont_use sky130_fd_sc_hd__a211o_2 -dont_use sky130_fd_sc_hd__a211o_4 -dont_use sky130_fd_sc_hd__a211oi_1 -dont_use sky130_fd_sc_hd__a211oi_2 -dont_use sky130_fd_sc_hd__a211oi_4 -dont_use sky130_fd_sc_hd__a21bo_1 -dont_use sky130_fd_sc_hd__a21bo_2 -dont_use sky130_fd_sc_hd__a21bo_4 -dont_use sky130_fd_sc_hd__a21o_2 -dont_use sky130_fd_sc_hd__a21o_4 -dont_use sky130_fd_sc_hd__a221o_1 -dont_use sky130_fd_sc_hd__a221o_2 -dont_use sky130_fd_sc_hd__a221o_4 -dont_use sky130_fd_sc_hd__a221oi_1 -dont_use sky130_fd_sc_hd__a221oi_2 -dont_use sky130_fd_sc_hd__a221oi_4 -dont_use sky130_fd_sc_hd__a222oi_1 -dont_use sky130_fd_sc_hd__a22o_1 -dont_use sky130_fd_sc_hd__a22o_2 -dont_use sky130_fd_sc_hd__a22o_4 -dont_use sky130_fd_sc_hd__a2bb2o_1 -dont_use sky130_fd_sc_hd__a2bb2o_2 -dont_use sky130_fd_sc_hd__a2bb2o_4 -dont_use sky130_fd_sc_hd__a2bb2oi_4 -dont_use sky130_fd_sc_hd__a311o_1 -dont_use sky130_fd_sc_hd__a311o_2 -dont_use sky130_fd_sc_hd__a311o_4 -dont_use sky130_fd_sc_hd__a311oi_1 -dont_use sky130_fd_sc_hd__a311oi_2 -dont_use sky130_fd_sc_hd__a311oi_4 -dont_use sky130_fd_sc_hd__a31o_1 -dont_use sky130_fd_sc_hd__a31o_2 -dont_use sky130_fd_sc_hd__a31o_4 -dont_use sky130_fd_sc_hd__a32o_1 -dont_use sky130_fd_sc_hd__a32o_2 -dont_use sky130_fd_sc_hd__a32o_4 -dont_use sky130_fd_sc_hd__a32oi_4 -dont_use sky130_fd_sc_hd__a41o_1 -dont_use sky130_fd_sc_hd__a41o_2 -dont_use sky130_fd_sc_hd__a41o_4 -dont_use sky130_fd_sc_hd__a41oi_1 -dont_use sky130_fd_sc_hd__a41oi_4 -dont_use sky130_fd_sc_