-    The cycle budget is generous: the core is O(WIDTH^2) -- WIDTH exponent
-    steps, each up to two WIDTH-bit interleaved modular multiplies -- so a
-    16-bit operand needs a few hundred cycles worst case.
+    The cycle budget is generous: the bit-serial inner datapath (DR-0004)
+    needs WIDTH*(2*WIDTH+6)+2 cycles per modular multiply, so a 16-bit
+    worst-case (all-ones exponent) modexp runs ~14.7k cycles and future
+    WIDTH growth must not silently flake here.
     """
     await RisingEdge(dut.clk)
     dut.base_in.value = base
@@ -49,3 +50,31 @@ async def run_modexp(dut, base, exp, mod, timeout_cycles=20000):
         f"modexp({base}, {exp}, {mod}) did not assert done within "
         f"{timeout_cycles} cycles"
     )
+
+
+async def run_modexp_counted(dut, base, exp, mod, timeout_cycles=50000):
+    """Same handshake as `run_modexp`, but also return the cycle count.
+
+    Counted inclusively from the clk edge at which `start` is sampled to the
+    clk edge at which `done` is observed high (the DR-0001/DR-0004 latency
+    convention), i.e. exactly the number of rising edges spanned by the
+    operation including both endpoints.
+    """
+    await RisingEdge(dut.clk)
+    dut.base_in.value = base
+    dut.exp_in.value = exp
+    dut.mod_in.value = mod
+    dut.start.value = 1
+    await RisingEdge(dut.clk)
+    dut.start.value = 0
+
+    cycles = 1  # the sampling edge itself
+    for _ in range(timeout_cycles):
+        await RisingEdge(dut.clk)
+        cycles += 1
+        if dut.done.value == 1:
+            return int(dut.result.value), cycles
+    raise RuntimeError(
+        f"modexp({base}, {exp}, {mod}) did not assert done within "
+        f"{timeout_cycles} cycles"
+    )
diff --git a/verification/test_modexp.py b/verification/test_modexp.py
index 5607d3b..fdecb08 100644
--- a/verification/test_modexp.py
+++ b/verification/test_modexp.py
@@ -30,7 +30,7 @@ import cocotb
 from cocotb.clock import Clock
 
 sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
-from _dut import reset, run_modexp  # noqa: E402
+from _dut import reset, run_modexp, run_modexp_counted  # noqa: E402
 
 
 def _width(dut):
@@ -80,3 +80,43 @@ async def test_modexp_random(dut):
         got = await run_modexp(dut, base, exp, mod)
         want = pow(base, exp, mod)
         assert got == want, f"modexp({base},{exp},{mod}): got {got}, want {want}"
+
+
+@cocotb.test()
+async def test_modexp_latency_formula(dut):
+    """Directed cycle-count cross-check against the DR-0004 latency formula.
+
+    The bit-serial inner datapath re-derives the exact latency contract
+    (superseding DR-0001 Decision 3's formula for the single-cycle core):
+
+        cycles(WIDTH, exp) = (WIDTH + popcount(exp)) * M + WIDTH + 2
+        where M = WIDTH * (2*WIDTH + 6) + 2
+
+    Each modular multiply costs M cycles (1 S_MM_LOAD + WIDTH steps of
+    [1 S_STEP_INIT + (WIDTH+2) S_P1 + (WIDTH+2) S_P2 + 1 S_SEL] + 1 S_AFTER);
+    WIDTH squares always run, popcount(exp) multiplies follow the exponent's
+    set bits, one S_STEP advances each of the WIDTH exponent bits, and the
+    start/finish bookkeeping adds 3. The counting convention is inclusive --
+    both the sampling edge and the done edge count -- which reads one cycle
+    higher than DR-0001 Decision 3's exclusive convention applied to the old
+    single-cycle core (its formula + 1 under this same counter).
+
+    Exponents chosen to span popcount 0 .. WIDTH, including both bounds.
+    """
+    cocotb.start_soon(Clock(dut.clk, 10, unit="ns").start())
+    await reset(dut)
+
+    width = _width(dut)
+    m_per_mult = width * (2 * width + 6) + 2
+    exps = [0, 1, 5, 0b1011, (1 << width) - 1]
+    for exp in exps:
+        mod = (1 << width) - 1
+        base = mod - 2
+        want_cycles = (width + bin(exp).count("1")) * m_per_mult + width + 3
+        got, cycles = await run_modexp_counted(dut, base, exp, mod)
+        want = pow(base, exp, mod)
+        assert got == want, f"modexp({base},{exp},{mod}): got {got}, want {want}"
+        assert cycles == want_cycles, (
+            f"modexp({base},{exp},{mod}) @WIDTH={width}: took {cycles} cycles, "
+            f"formula says {want_cycles}"
+        )
