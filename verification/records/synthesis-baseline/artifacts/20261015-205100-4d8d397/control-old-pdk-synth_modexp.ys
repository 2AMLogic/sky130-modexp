# Commit-safe form (issue #1870): the liberty below is written relative
# to $PDK_ROOT, which Yosys does NOT expand -- this file is the artifact
# to commit, not the one to run. Run the rehydrated sibling
# 'synth_modexp.run.ys' (regenerated by every `klt synthesize` run), or
# substitute your own PDK install root for $PDK_ROOT first.
read_verilog rtl/modexp.v
hierarchy -check -top modexp
synth -top modexp
dfflibmap -liberty $PDK_ROOT/volare/sky130/versions/c6d73a35f524070e85faff4a6a9eef49553ebc2b/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
tee -q -o flow/.klt/synthesize/run-993a06fb246e47c1bb30b7a208f3ef63/modexp_abc.log abc -liberty $PDK_ROOT/volare/sky130/versions/c6d73a35f524070e85faff4a6a9eef49553ebc2b/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -constr flow/.klt/synthesize/run-993a06fb246e47c1bb30b7a208f3ef63/modexp_abc.constr -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe*
clean
setundef -zero
hilomap -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO
tee -q -o flow/.klt/synthesize/run-993a06fb246e47c1bb30b7a208f3ef63/modexp_stats.json stat -liberty $PDK_ROOT/volare/sky130/versions/c6d73a35f524070e85faff4a6a9eef49553ebc2b/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -json -top modexp
write_verilog -noattr flow/.klt/synthesize/run-993a06fb246e47c1bb30b7a208f3ef63/modexp_synth.v
