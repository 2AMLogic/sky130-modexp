# flow/run-corner-sweep.sh's per-corner scratch requests/outputs and its
# aggregated summary -- regenerated on demand; the evidence that matters is
# frozen under verification/records/place-and-route/artifacts/ instead.
flow/corners/
flow/corner-sweep-results.json
# local klt install, created by the setup script
.venv/

# klt / cocotb / Icarus scratch (verification/cross_check.py and ad-hoc
# `klt functional-verification` / `klt synthesize` runs) -- never committed;
# deliberate evidence lands under verification/records/ via --mint-record.
.klt/
**/.klt/
sim_build*/
results.xml
results_icarus.xml
# verification/gate-level/run-gate-level-sim.sh links the resolved sky130A
# cell-model files into the request's own directory under fixed names, so
# the committed request can name them with machine-independent relative
# paths (klt.functional_verification.request/1 has no PDK block). The links
# point outside the repo and are recreated on every run -- never committed.
verification/gate-level/pdk-*.v
